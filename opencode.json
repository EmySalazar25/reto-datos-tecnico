{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "autoupdate": false,
  "permission": {
    "edit": {
      "*": "allow",
      "standard/policy.yml": "deny",
      "data/replica/*": "deny",
      ".github/*": "ask"
    },
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed -n *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "dp *": "allow",
      ".venv/bin/dp *": "allow",
      ".venv/bin/pytest*": "allow",
      "make setup": "allow",
      "make ingest": "allow",
      "make build": "allow",
      "make all": "allow",
      "make test": "allow",
      "make certify": "allow",
      "make verify": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git switch -c *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push -u origin fix/*": "allow",
      "git push -u origin feature/*": "allow",
      "gh pr create *": "allow",
      "gh pr view *": "allow",
      "gh run view *": "allow",
      "gh workflow run destructivo.yml *": "allow",
      "dp chaos inject *": "ask",
      "dp chaos restore *": "ask",
      ".venv/bin/dp chaos inject *": "ask",
      ".venv/bin/dp chaos restore *": "ask",
      "dbt *": "deny",
      ".venv/bin/dbt *": "deny",
      "*/bin/dbt *": "deny",
      "*python* -m dbt*": "deny",
      "duckdb *": "deny",
      "*import duckdb*": "deny",
      "*--full-refresh*": "deny",
      "rm *": "deny",
      "find * -delete*": "deny",
      "*-exec rm*": "deny",
      "truncate *": "deny",
      "git clean*": "deny",
      "make clean*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push origin main*": "deny",
      "git reset --hard*": "deny",
      "sed -i*standard/*": "deny",
      "sed -i*data/replica/*": "deny",
      "*> standard/*": "deny",
      "*>standard/*": "deny",
      "*> data/replica/*": "deny",
      "*>data/replica/*": "deny",
      "*> *.duckdb*": "deny"
    },
    "webfetch": "ask"
  }
}
