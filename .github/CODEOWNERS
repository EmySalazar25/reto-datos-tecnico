# Rutas protegidas del estándar (política, certificación, agente y CI). GOV-07 las lee de la
# versión base: un cambio en ellas requiere aprobación en el environment `aprobacion-estandar`,
# ligada a la huella del cambio, aunque el repositorio tenga una sola persona. En un fork,
# reemplaza el usuario por el de quien administra el estándar.
/standard/          @EmySalazar25
/src/dp/certify/    @EmySalazar25
/.github/           @EmySalazar25

# La CLI rechaza la recarga completa y ejecuta lo destructivo solo con una propuesta aprobada;
# propose.py genera la evidencia de cada propuesta.
/src/dp/cli.py      @EmySalazar25
/src/dp/propose.py  @EmySalazar25
# Las capacidades que el servidor MCP expone a cualquier agente: ampliarlas es un cambio gobernado.
/src/dp/mcp.py      @EmySalazar25

# Contexto y configuración de cada agente: cualquier cliente, no solo opencode.
/AGENTS.md          @EmySalazar25
/.agents/           @EmySalazar25
/opencode.json      @EmySalazar25
/CLAUDE.md          @EmySalazar25
/.claude/           @EmySalazar25
/.cursor/           @EmySalazar25
/.mcp.json          @EmySalazar25

# El contenedor decide qué credenciales recibe el agente (ADR 0008).
/Dockerfile         @EmySalazar25
/compose.yaml       @EmySalazar25
/docker/            @EmySalazar25

# Lo que configura la frontera humana en GitHub y lo que mide la credencial del agente.
